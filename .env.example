# Copy to .env on the droplet and set INGEST_API_KEY to a 32+ char random string.
# Generate one with:  openssl rand -hex 32
INGEST_API_KEY=

# ManRocket analytics ingest only (POST /v1/manrocket/events, /crash, /bugreport).
# Use a different value from INGEST_API_KEY. Same generation: openssl rand -hex 32
# Minimum 24 characters. If unset or shorter, those three routes return 401
# and the rest of the service (including Cynthion ingest) still starts.
MANROCKET_INGEST_API_KEY=
